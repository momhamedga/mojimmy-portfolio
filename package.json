{
  "name": "mojimmy-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:cross-browser": "playwright test --project=firefox-smoke --workers=2",
    "test:e2e:prod": "playwright test --project=chromium-production-smoke --workers=1",
    "test:e2e:prod:webkit": "playwright test --project=webkit-production-smoke --workers=1"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.1",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.8",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.2"
  }
}
